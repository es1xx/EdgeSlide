[Unit]
Description=EdgeSlide touchpad edge gesture controller
Documentation=file:%h/.local/share/doc/edgeslide/README.md
After=graphical-session.target pipewire-pulse.service
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/edgeslide-daemon
Restart=on-failure
RestartSec=5
TimeoutStopSec=3
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
UMask=0077

[Install]
WantedBy=default.target
